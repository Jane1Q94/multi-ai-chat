{
  "manifest_version": 3,
  "name": "Multi AI Chat — 多模型回答对比",
  "version": "1.0.2",
  "description": "把同一个问题发送给多个 AI 网页版，并排比较回答。数据仅在浏览器与所选 AI 服务之间处理。",
  "homepage_url": "https://github.com/Jane1Q94/multi-ai-chat",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "tabs",
    "storage",
    "scripting",
    "clipboardWrite",
    "favicon"
  ],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://www.doubao.com/*",
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://qianwen.com/*",
    "https://*.qianwen.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/*",
        "https://chat.deepseek.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://qianwen.com/*",
        "https://*.qianwen.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "all_frames": true,
      "js": ["src/sites.js", "src/store.js", "src/sanitize.js", "src/content/inject.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "打开 Multi AI Chat",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  }
}
